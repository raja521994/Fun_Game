# Server
PORT=3000
NODE_ENV=development

# Database - SQLite by default (file path). For PostgreSQL on Render, set DATABASE_URL
DATABASE_URL=./data/fungame.db

# Client URL (for CORS). In production on Render this is usually the same origin
CLIENT_URL=http://localhost:5173

# Session / Host token secret (change in production)
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Scoring (quiz mode)
QUIZ_BASE_SCORE=1000
QUIZ_TIME_BONUS_MAX=500
